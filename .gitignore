# macOS
.DS_Store

# local artifacts of a validation run
*.parquet
__pycache__/
.venv/

# results copied into the repo are kept, everything else is not
*.root
*.csv
*.log
*.png
*.pdf
!gpf_validation/**/*.root
!gpf_validation/**/*.csv
!gpf_validation/**/*.log
!gpf_validation/**/*.png
!gpf_validation/*.root
!gpf_validation/*.csv
!gpf_validation/*.log

# summary artifacts of a timing run
!gpf_timing/**/*.csv
!gpf_timing/**/*.png
!gpf_compare/**/*.csv
!gpf_compare/**/*.png
!gpf_compare/**/*.log

# large & regenerable outputs of a validation run
gpf_validation/tables_*/

# input n-tuples & geometry, far too large to track
data/
