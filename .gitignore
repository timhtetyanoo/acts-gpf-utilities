# macOS
.DS_Store
__pycache__/

# the inputs, far too large to track
/data/

# results/: everything is ignored except the small files that summarise a run,
# so that they can be pushed next to the code. The patterns, the tables, the
# tuples, the raw timings and the logs stay local. Each machine has its folder,
# results/<host>/, so the runs of several machines can be pushed side by side.
/results/**
!/results/**/
!/results/**/run_info.txt
!/results/**/validation/scores.csv
!/results/**/validation/metrics.log
!/results/**/validation/plots/*.png
!/results/**/performance/summary.csv
!/results/**/performance/event_times.png
!/results/**/performance/stages.png
!/results/**/hough/**/*.pdf
# a comparison of two runs
!/results/*/compare/**/patterns.log
!/results/*/compare/**/scores.csv
!/results/*/compare/**/performance.csv
!/results/*/compare/**/performance.log
!/results/*/compare/**/plots/*.png
!/results/*/compare/**/event_times.png
!/results/*/compare/**/stages.png
